graph TB
    subgraph "エッジデバイス層"
        subgraph "Raspberry Pi #1"
            QR1[QRリーダー]
            NFC1[NFCリーダー]
            CAM1[カメラ]
            GPIO1[GPIO制御]
            APP1[制御アプリ<br/>Python]

            QR1 --> APP1
            NFC1 --> APP1
            CAM1 --> APP1
            APP1 --> GPIO1
        end

        subgraph "Raspberry Pi #2"
            QR2[QRリーダー]
            NFC2[NFCリーダー]
            CAM2[カメラ]
            GPIO2[GPIO制御]
            APP2[制御アプリ<br/>Python]

            QR2 --> APP2
            NFC2 --> APP2
            CAM2 --> APP2
            APP2 --> GPIO2
        end

        GPIO1 --> DOOR1[電子錠]
        GPIO1 --> LED1[LED表示]
        GPIO1 --> SOUND1[音声通知]

        GPIO2 --> DOOR2[電子錠]
        GPIO2 --> LED2[LED表示]
        GPIO2 --> SOUND2[音声通知]
    end

    subgraph "ネットワーク層"
        VPN[Tailscale VPN]
        APP1 -.->|セキュア通信| VPN
        APP2 -.->|セキュア通信| VPN
    end

    subgraph "クラウドエッジ層"
        CF_WORK[Cloudflare Workers<br/>API Functions]
        CF_D1[(Cloudflare D1<br/>Database)]
        CF_PAGES[Cloudflare Pages<br/>Static Hosting]

        VPN --> CF_WORK
        CF_WORK --> CF_D1
    end

    subgraph "フロントエンド層"
        DASHBOARD[ダッシュボード<br/>React + TypeScript]
        CHART[データ可視化<br/>Chart.js]

        CF_PAGES --> DASHBOARD
        DASHBOARD --> CHART
    end

    subgraph "データフロー"
        OCCUPANCY[在館人数管理]
        METRICS[システムメトリクス]
        AUTH[認証ログ]

        APP1 --> OCCUPANCY
        APP2 --> OCCUPANCY
        APP1 --> METRICS
        APP2 --> METRICS
        APP1 --> AUTH
        APP2 --> AUTH

        OCCUPANCY --> CF_D1
        METRICS --> CF_D1
        AUTH --> CF_D1
    end

    USER[管理者] --> DASHBOARD
    DASHBOARD --> CF_WORK

    style APP1 fill:#f9f,stroke:#333,stroke-width:2px
    style APP2 fill:#f9f,stroke:#333,stroke-width:2px
    style CF_WORK fill:#ff9,stroke:#333,stroke-width:2px
    style DASHBOARD fill:#9ff,stroke:#333,stroke-width:2px
    style VPN fill:#f99,stroke:#333,stroke-width:2px
